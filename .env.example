# mmcp needs exactly these four variables. Everything else is configured in the admin console.
POSTGRES_DSN=postgres://mmcp:change-me@postgres:5432/mmcp?sslmode=disable
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Now-2026!
# 32-byte key (base64/hex) or a 32+ character passphrase. Generate: docker run --rm mmcp:v1.0.0 gen-key
# Rotation: ENCRYPTION_KEY="<new>,<old>" then "재래핑" in 키 관리, then drop <old>.
ENCRYPTION_KEY=
